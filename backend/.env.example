# Backend Environment Variables Template for CampusShare

PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB daemon or Atlas connection URI. If offline, in-memory runner is used in dev.
MONGODB_URI=mongodb://localhost:27017/campusshare

# JWT Signing Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key_32_bytes

JWT_EXPIRES_IN=7d

# Allowed Institutional Email Domains (comma-separated suffixes or domains)
ALLOWED_EMAIL_DOMAINS=.edu,.ac.in,.org,campus.edu

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATION & SMTP CONFIGURATION
# -----------------------------------------------------------------------------
# Set to 'true' to enable external email delivery, or 'false' for in-app notifications only.
EMAIL_ENABLED=true

# SMTP Host (e.g., smtp.gmail.com for Gmail, sandbox.smtp.mailtrap.io for Mailtrap)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS direct connection (true for port 465, false for 587 STARTTLS)
SMTP_SECURE=false

# SMTP Username / Sender Email (e.g., your_email@gmail.com)
SMTP_USER=your_email@gmail.com

# SMTP Password or App Password (For Gmail: Use a 16-character Google App Password)
SMTP_PASS=your_app_password_here

# From address shown in the recipient inbox
EMAIL_FROM="CampusShare Notifications <no-reply@campusshare.edu>"
