# Root Environment Variables Template for CampusShare

# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# Connects to your local MongoDB daemon, remote MongoDB Atlas cluster,
# or automatically falls back to an embedded in-memory MongoDB runner if no instance is active.
MONGODB_URI=mongodb://localhost:27017/campusshare

# JWT Signing Secret:
# To generate a cryptographically strong secret, run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key_32_bytes

# JWT Expiration Period (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed Institutional Domains (comma-separated):
# Used during registration to verify educational affiliation.
ALLOWED_EMAIL_DOMAINS=.edu,.ac.in,.org,campus.edu

# Cross-Origin Resource Sharing (CORS) origin:
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS & SMTP CONFIGURATION
# -----------------------------------------------------------------------------
# Set to 'true' to enable external email notifications alongside in-app alerts.
EMAIL_ENABLED=true

# SMTP Server Host (e.g. smtp.gmail.com, sandbox.smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Set to 'true' if using port 465, or 'false' for STARTTLS on port 587
SMTP_SECURE=false

# SMTP Username / Authenticated email address
SMTP_USER=your_email@gmail.com

# SMTP Password / App Password (For Gmail, generate an App Password in Google Account Security)
SMTP_PASS=your_app_password_here

# Display Name & Sender address in recipient mail client
EMAIL_FROM="CampusShare Notifications <no-reply@campusshare.edu>"

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
